DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*

# Faster local API boot: drf-spectacular + /api/v1/schema/ only when true
ENABLE_OPENAPI=false

PHONE_NUMBER_VERIFICATION_CODE_LENGTH=4
PHONE_NUMBER_VERIFICATION_CODE_LIFE=300
PHONE_NUMBER_VERIFICATION_CODE_SEND_LIMIT=120
USER_OFFER_SCORE_LIMIT=1000

# --- Database ---
# Default: DEBUG=True → SQLite at backend/db.sqlite3
# Production: DEBUG=False and PostgreSQL settings below (or USE_POSTGRES=1)
# USE_POSTGRES=1   Force PostgreSQL while DEBUG=True
# USE_SQLITE=1     Force SQLite while DEBUG=False

DB_NAME=customerclub_kiosk
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

SMS_API_KEY=replace-with-provider-key
SMS_LINE_NUMBER=30007732011066

# -----------------------------
# NFC Authentication (Backend)
# -----------------------------
NFC_BRIDGE_SECRET=
NFC_LOGIN_TOKEN_TTL=60
FRONTEND_BASE_URL=http://127.0.0.1:5002
NFC_TAG_MAX_FAILED_ATTEMPTS=5
NFC_TAG_LOCK_SECONDS=1800
NFC_LOGIN_RATE_WINDOW=60
NFC_LOGIN_RATE_MAX=30

# Management server (catalog + offers source of truth)
MANAGEMENT_API_BASE_URL=http://127.0.0.1:8000
MANAGEMENT_SERVICE_API_KEY=change-me-integration-key
MANAGEMENT_API_TIMEOUT=15
# Reduce calls to management (seconds). Stale copies are kept longer for throttle fallback.
MANAGEMENT_CACHE_TTL_SHOPS=600
MANAGEMENT_CACHE_TTL_CATALOG=300
MANAGEMENT_CACHE_TTL_OFFERS=120
PUBLIC_API_BASE_URL=http://127.0.0.1:8001

# Stateless kiosk: no business data on this server (default: true)
STATELESS_KIOSK=true
