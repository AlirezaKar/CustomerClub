# =============================================================================
# Django — copy to .env and set real values (never commit .env)
# =============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# --- Database ---
# Default: DEBUG=True → SQLite at backend/db.sqlite3 (no Postgres needed locally).
# Production: set DEBUG=False and fill PostgreSQL settings below.
# Optional overrides:
# USE_POSTGRES=1   # force PostgreSQL while DEBUG=True
# USE_SQLITE=1     # force SQLite while DEBUG=False (not recommended for prod)

# PostgreSQL (used when DEBUG=False, or when USE_POSTGRES=1)
DB_NAME=customerclub_management
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# When DEBUG=False: comma-separated CORS origins for the SPA
# CORS_ORIGINS=https://your-frontend.example.com

# Shared secret for main CustomerClub server integration API:
#   GET  /api/integration/shops/
#   GET  /api/integration/customer-offers/?phone_number=&shop_id=
#   GET  /api/integration/end-users/?phone_number=
#   POST /api/integration/end-users/  (register club member)
#   POST /api/integration/special-offer-transactions/  (mirror kiosk redemption from main server)
#   POST /api/integration/dataset-import/  (bulk seed from Dataset/ — send_dataset_to_management.py)
MANAGEMENT_SERVICE_API_KEY=change-me-integration-key

# Media: uploaded files are stored under backend/media/ (MEDIA_ROOT).
# Run migrations after changing DB; create media/ if missing (see media/.gitkeep).
